// Prisma schema for Job Outreach Pro
// PostgreSQL on Oracle Cloud Always Free

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth.js Models ────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime? @map("email_verified")
  hashedPassword String?   @map("hashed_password")
  image          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts        Account[]
  sessions        Session[]
  userSettings    UserSettings?
  templates       Template[]
  resumes         Resume[]
  contacts        Contact[]
  outreachHistory OutreachHistory[]
  emailCampaigns  EmailCampaign[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Application Models ────────────────────────────────

model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique @map("user_id")
  senderEmail            String?  @map("sender_email")
  encryptedAppPassword   String?  @map("encrypted_app_password")
  emailConfigured        Boolean  @default(false) @map("email_configured")
  emailVerified          Boolean  @default(false) @map("email_verified")
  emailVerificationError String?  @map("email_verification_error")
  lastVerifiedAt         DateTime? @map("last_verified_at")
  defaultResumeId        String?  @map("default_resume_id")
  sendDelayMin           Int      @default(8) @map("send_delay_min")
  sendDelayMax           Int      @default(20) @map("send_delay_max")
  delayPreset            String   @default("moderate") @map("delay_preset")
  businessHoursOnly      Boolean  @default(true) @map("business_hours_only")
  followUpDays           Int      @default(3) @map("follow_up_days")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Template {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  name      String
  subject   String?
  body      String    @db.Text
  type      String    @default("email")
  category  String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreachHistory OutreachHistory[]
  emailCampaigns  EmailCampaign[]

  @@map("templates")
}

model Resume {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  displayName String   @map("display_name")
  fileUrl     String   @map("file_url")
  fileName    String   @map("file_name")
  fileSize    Int?     @map("file_size")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreachHistory OutreachHistory[]
  emailCampaigns  EmailCampaign[]

  @@map("resumes")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String?
  email     String
  company   String?
  position  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreachHistory OutreachHistory[]

  @@unique([userId, email])
  @@map("contacts")
}

model OutreachHistory {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  contactId  String?   @map("contact_id")
  templateId String?   @map("template_id")
  resumeId   String?   @map("resume_id")
  type       String    @default("email")
  subject    String?
  content    String?   @db.Text
  status     String    @default("sent")
  trackingId String?   @map("tracking_id")
  metadata   Json?
  sentAt     DateTime  @default(now()) @map("sent_at")
  openedAt   DateTime? @map("opened_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  resume   Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@map("outreach_history")
}

model EmailCampaign {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  name             String?
  templateId       String?   @map("template_id")
  resumeId         String?   @map("resume_id")
  status           String    @default("draft")
  totalRecipients  Int       @default(0) @map("total_recipients")
  sentCount        Int       @default(0) @map("sent_count")
  failedCount      Int       @default(0) @map("failed_count")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  lastProcessedAt  DateTime? @map("last_processed_at")
  currentBatchSize Int?      @map("current_batch_size")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  resume     Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@map("email_campaigns")
}

model CampaignRecipient {
  id           String    @id @default(cuid())
  campaignId   String    @map("campaign_id")
  name         String?
  email        String
  company      String?
  position     String?
  status       String    @default("pending")
  sentAt       DateTime? @map("sent_at")
  trackingId   String?   @map("tracking_id")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_recipients")
}
